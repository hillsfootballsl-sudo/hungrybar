# Local development: copy to .env (Node) and/or .dev.vars (Cloudflare preview).
# On Cloudflare: add these under the Worker's Settings → Variables and Secrets.
# ── Database (Supabase → Connect) ──
# Pooled connection (port 6543) for the app:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Long random string — signs staff & customer logins. Generate: openssl rand -base64 48
AUTH_SECRET=""

# Public address of the site (used for QR codes & PayHere return links)
SITE_URL="https://hungrybar.lk"

# ── SMS for phone OTP + low-stock alerts ──
# "console" = no SMS sent. Use "notifylk" or "textlk" when live.
SMS_PROVIDER="console"
# Only for a private trial before SMS is set up: shows the login code on screen.
# Anyone could then sign in as any phone number — remove it before telling customers about the site.
OTP_TEST_MODE=""
NOTIFYLK_USER_ID=""
NOTIFYLK_API_KEY=""
NOTIFYLK_SENDER_ID="NotifyDEMO"
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""

# ── PayHere card payments (https://www.payhere.lk → Settings → Domains & Credentials) ──
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# "true" = sandbox test payments, "false" = real money
PAYHERE_SANDBOX="true"

# ── Push notifications for order updates (generate once: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:orders@hungrybar.lk"

# ── Protects the nightly points job (/api/cron/daily). Any long random string. ──
CRON_SECRET=""

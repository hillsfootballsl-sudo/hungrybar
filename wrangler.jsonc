{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name in your Cloudflare dashboard
  "name": "hungrybar",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hungrybar" }],
  // Run close to the Supabase database instead of close to each visitor (fewer slow round trips)
  "placement": { "mode": "smart" },
  // 00:30 UTC = 6:00 am in Sri Lanka
  "triggers": { "crons": ["30 0 * * *"] },
  "observability": { "enabled": true },
  // Keep the text variables you add in the dashboard (Settings → Variables and Secrets) on every GitHub deploy
  "keep_vars": true
}
